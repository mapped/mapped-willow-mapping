{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "enabled": false,
      "matchPackagePatterns": [
        ".*"
      ]
    },
    {
      "automerge": true,
      "commitMessage": "Update Mapped Ontologies DTDL package",
      "enabled": true,
      "labels": [
        "renovate",
        "auto"
      ],
      "matchPackagePatterns": [
        "Mapped\\.Ontologies\\.Core\\.Dtdl"
      ],
      "prBodyColumns": [
        "Package",
        "Change"
      ]
    },
    {
      "automerge": true,
      "commitMessage": "Update WillowInc Ontology DTDLv3 package",
      "enabled": true,
      "labels": [
        "renovate",
        "auto"
      ],
      "matchPackagePatterns": [
        "WillowInc\\.Ontology\\.DTDLv3"
      ],
      "prBodyColumns": [
        "Package",
        "Change"
      ]
    }
  ]
}
